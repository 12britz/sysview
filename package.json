{
  "name": "@12britz/sysview",
  "version": "1.0.2",
  "description": "A beautiful CLI tool for system monitoring - ports, network, memory, CPU, disk with colorful tables",
  "main": "dist/main.js",
  "bin": {
    "sysview": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc && node dist/main.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "system",
    "monitor",
    "ports",
    "network",
    "memory",
    "cpu",
    "disk",
    "process",
    "git",
    "terminal",
    "dashboard"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "inquirer": "^8.2.5",
    "systeminformation": "^5.21.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
